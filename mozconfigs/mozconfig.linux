# ghostfox Linux build (js standalone)
ac_add_options --enable-project=js
ac_add_options --enable-optimize=-O2
ac_add_options --disable-jemalloc
ac_add_options --disable-tests
mk_add_options MOZ_PARALLEL_BUILD=$(nproc)
# FF158 pins LLVM >= 19.1.4: Mozilla's toolchain lands under ~/.mozbuild after
# `./mach bootstrap`, or point these at brew/distro clang 19+.
export PATH=$HOME/.mozbuild/clang/bin:$HOME/.cargo/bin:$PATH
export CC=$HOME/.mozbuild/clang/bin/clang
export CXX=$HOME/.mozbuild/clang/bin/clang++
