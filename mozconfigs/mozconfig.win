# ghostfox Windows build (js standalone, VS2022 clang-cl)
ac_add_options --enable-project=js
ac_add_options --enable-optimize="-O2"
ac_add_options --disable-jemalloc
ac_add_options --disable-tests
ac_add_options --without-intl-api
ac_add_options --enable-debug-symbols
mk_add_options MOZ_PARALLEL_BUILD=8
# Adjust to your VS2022 clang-cl install (must be >= 19.1.4 for FF158).
export CC="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe"
export CXX="C:/Program Files/Microsoft Visual Studio/2022/Community/VC/Tools/Llvm/x64/bin/clang-cl.exe"
